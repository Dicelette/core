{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"rootDir": "./",
		"strict": true,
		"importHelpers": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"removeComments": false,
		"types": ["node"],
		"sourceMap": false
	},
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
